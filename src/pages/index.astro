---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { site, projects } from "../data/site";

const posts = await getPosts();
---

<Base>
  <section class="profile" aria-labelledby="profile-name">
    <img
      class="profile-photo"
      src="/manisha-subedi.jpg"
      alt="Manisha Subedi"
      width="180"
      height="180"
    />
    <div class="profile-details">
      <h1 id="profile-name">{site.name}</h1>
      <p class="profile-role">{site.role}</p>
      <p class="profile-location">{site.location}</p>
      <p class="profile-links">
        <a class="profile-link" href={site.linkedin} target="_blank" rel="noreferrer">
          LinkedIn
        </a>
        <a class="profile-link" href="/manisha-subedi-cv.pdf">CV</a>
      </p>
    </div>
  </section>

  <section class="intro" aria-label="Introduction">
    <p>
      I work as a data engineer at Leapfrog Technology. I build data pipelines
      for reports and analysis. These pipelines load, check, and model data.
      Before this, I was a data engineering intern at Bengen and a junior data
      analyst intern at Company C (placeholder).
    </p>
    <p>
      I write short posts about data analysis. I use illustrations to explain
      averages, joins, comparisons, and charts.
    </p>
  </section>

  <section class="content-section">
    <h2>Writing</h2>
    <PostList posts={posts} />
  </section>

  <section class="content-section">
    <h2>Projects</h2>
    <ul class="post-list">
      {projects.map((p) => (
        <li>
          <a href={p.url ?? "/projects/"}>{p.title}</a>
          <span class="status">{p.status}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
