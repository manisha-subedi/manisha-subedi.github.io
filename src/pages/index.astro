---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import Garden from "../components/Garden.astro";
---

<Base>
  <section class="profile" aria-labelledby="profile-name">
    <img
      class="profile-photo"
      src="/manisha-subedi.jpg"
      alt="Manisha Subedi"
      width="180"
      height="180"
    />
    <div class="profile-details">
      <h1 id="profile-name">{site.name}</h1>
      <p class="profile-role">{site.role}</p>
      <p class="profile-location">{site.location}</p>
      <p class="profile-links">
        <a class="profile-link" href={site.linkedin} target="_blank" rel="noreferrer">
          LinkedIn
        </a>
        <a class="profile-link" href="/manisha-subedi-cv.pdf">CV</a>
      </p>
    </div>
  </section>

  <section class="intro" aria-label="Introduction">
    <p>
      I'm a data analyst working with Power BI, SQL, and Python. Previously, I
      was a data analyst and BI intern at BenGen, where I built Power BI
      datasets and dashboards and worked on Databricks pipelines.
    </p>
    <p>
      I enjoy using charts and examples to explain data. This site is where
      I share my projects and writing.
    </p>
  </section>

  <Garden />
</Base>
