---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { site, projects } from "../data/site";

const posts = await getPosts();
---

<Base>
  <section class="profile" aria-labelledby="profile-name">
    <img
      class="profile-photo"
      src="/manisha-subedi.jpg"
      alt="Manisha Subedi"
      width="180"
      height="180"
    />
    <div class="profile-details">
      <h1 id="profile-name">{site.name}</h1>
      <p class="profile-role">{site.role}</p>
      <p class="profile-location">{site.location}</p>
      <p class="profile-links">
        <a class="profile-link" href={site.linkedin} target="_blank" rel="noreferrer">
          LinkedIn
        </a>
        <a class="profile-link" href="/manisha-subedi-cv.pdf">CV</a>
      </p>
    </div>
  </section>

  <section class="intro" aria-label="Introduction">
    <p>
      I'm a data analyst. Most of my work is in Power BI, SQL, and Python. My
      last job was a data analyst and BI intern at BenGen. There I built Power
      BI datasets and dashboards for campaign and audience reports, and helped
      with the Databricks pipelines behind them.
    </p>
    <p>
      On this site I write short posts about data. Each post takes one idea,
      like the average or the sample size, and explains it with a picture you
      can play with.
    </p>
  </section>

  <section class="content-section">
    <h2>Writing</h2>
    <PostList posts={posts} />
  </section>

  <section class="content-section">
    <h2>Projects</h2>
    <ul class="post-list">
      {projects.map((p) => (
        <li>
          <a href={p.url ?? "/projects/"}>{p.title}</a>
          <span class="status">{p.status}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
