---
import Base from "../layouts/Base.astro";
import { projects } from "../data/site";
---

<Base title="Projects" description="Data projects by Manisha Subedi.">
  <h1 class="small-page-title">Projects</h1>
  {
    projects.map((p) => (
      <article class="entry project">
        <div class="entry-heading">
          <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
          <p class="entry-date">{p.tools}</p>
        </div>
        <p>{p.text}</p>
        {(p.live || p.code) && (
          <p class="project-links">
            {p.live && <a href={p.live}>Project</a>}
            {p.code && <a href={p.code}>Code</a>}
          </p>
        )}
      </article>
    ))
  }
</Base>
