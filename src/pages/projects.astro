---
import Base from "../layouts/Base.astro";
import { projects } from "../data/site";
---

<Base title="Projects" description="Data projects by Manisha Subedi.">
  <h1 class="small-page-title">Projects</h1>
  {
    projects.map((p) => (
      <article class="entry project">
        <div class="entry-heading">
          <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
          <p class="entry-date">{p.status}</p>
        </div>
        <p>{p.text}</p>
        {p.example && <pre class="example">{p.example}</pre>}
        {p.image && <img class="project-image" src={p.image} alt={`${p.title}, result chart`} loading="lazy" />}
        {p.install && (
          <p class="install">
            Try it: <code>{p.install}</code>
          </p>
        )}
      </article>
    ))
  }
</Base>
