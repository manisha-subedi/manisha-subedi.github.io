---
import Base from "../layouts/Base.astro";
---

<Base title="About" description="About Manisha Subedi.">
  <h1 class="small-page-title">About</h1>
  <div class="about-copy">
    <p>
      Hi, I'm Manisha, a data analyst living in Amadora, near Lisbon.
    </p>
    <p>When I'm not working, I hike, listen to music, and draw.</p>
  </div>

  <figure class="about-figure">
    <img
      src="/lisboa-illustration.svg"
      alt="A painted illustration of Lisbon"
      width="1200"
      height="800"
      loading="lazy"
    />
  </figure>
</Base>
